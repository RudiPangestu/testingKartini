APP_NAME="SIPRES Kartini"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Jakarta
APP_URL=http://localhost:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=debug

# ------- DATABASE -------
# Opsi tercepat: SQLite (tanpa server DB)
DB_CONNECTION=sqlite
# jalankan: touch database/database.sqlite

# Opsi PostgreSQL (mis. reuse Neon) — set DB_CONNECTION=pgsql lalu isi:
# DB_CONNECTION=pgsql
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=sipres
# DB_USERNAME=postgres
# DB_PASSWORD=
# Untuk Neon (SSL): tambahkan di config/database.php connections.pgsql 'sslmode' => 'require'

SESSION_DRIVER=file
SESSION_LIFETIME=120
QUEUE_CONNECTION=sync
CACHE_STORE=file

# Email (opsional; log = tulis ke storage/logs)
MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@kartini.sch.id"
MAIL_FROM_NAME="${APP_NAME}"
