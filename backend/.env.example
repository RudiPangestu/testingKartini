# Database (PostgreSQL - mis. Supabase / Neon free tier)
DATABASE_URL="postgresql://user:password@localhost:5432/sipres_kartini?schema=public"

# Server
PORT=3000
NODE_ENV=development

# URL web (untuk tautan verifikasi email di pendaftaran mandiri)
APP_WEB_URL="http://localhost:5173"

# JWT
JWT_ACCESS_SECRET="ganti-dengan-secret-acak-yang-kuat"
JWT_ACCESS_EXPIRES="15m"
JWT_REFRESH_SECRET="ganti-dengan-secret-acak-yang-berbeda"
JWT_REFRESH_EXPIRES="7d"

# Seed admin awal
SEED_ADMIN_EMAIL="admin@kartini.sch.id"
SEED_ADMIN_PASSWORD="admin12345"
SEED_ADMIN_NAME="Administrator"

# ============================ NOTIFIKASI EMAIL ============================
# Notifikasi kehadiran ke orang tua dikirim lewat email. Kode mencoba provider
# secara berurutan (yang pertama terisi lengkap dipakai):
#   1) Gmail API  2) Mailjet  3) Resend  4) SMTP
# Cukup ISI SALAH SATU. Kosongkan sisanya. Jika semua kosong, notifikasi tetap
# masuk inbox aplikasi tetapi tidak terkirim ke email (dicatat di log).

# 1) Gmail API (kirim dari akun Gmail sendiri via OAuth, tanpa perlu domain)
GMAIL_CLIENT_ID=""
GMAIL_CLIENT_SECRET=""
GMAIL_REFRESH_TOKEN=""

# 2) Mailjet (cukup verifikasi email pengirim)
MAILJET_API_KEY=""
MAILJET_SECRET_KEY=""

# 3) Resend (butuh verifikasi domain)
RESEND_API_KEY=""
RESEND_FROM="SIPRES Kartini <onboarding@resend.dev>"

# 4) SMTP (mis. Gmail App Password / self-hosted). Untuk Gmail pakai App Password.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="SIPRES Kartini <no-reply@kartini.sch.id>"

# ============================ NOTIFIKASI WHATSAPP =========================
# WhatsApp gateway (opsional). Dipakai a.l. untuk rekap daftar hadir harian
# ke nomor admin. Kosongkan jika belum dipakai.
# FONNTE (fonnte.com): daftar -> Add Device -> scan QR WhatsApp pengirim ->
#   salin Token perangkat ke WA_TOKEN. URL-nya seperti di bawah.
#   Nomor tujuan pakai format 628xxxxxxxxxx (kode negara, tanpa + atau 0 depan).
WA_GATEWAY_URL="https://api.fonnte.com/send"
WA_TOKEN=""
