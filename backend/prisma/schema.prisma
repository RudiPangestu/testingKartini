// Skema database SIPRES Kartini
// Dokumentasi lengkap: docs/DATABASE.md

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ===================== ENUM =====================

enum Role {
  ADMIN
  GURU
  ORTU
  MURID
}

enum Gender {
  L
  P
}

enum DayOfWeek {
  SEN
  SEL
  RAB
  KAM
  JUM
  SAB
}

enum AttendanceSource {
  SCHEDULE
  EVENT
}

enum AttendanceStatus {
  HADIR
  SAKIT
  IZIN
  ALPHA
}

enum TermType {
  SEMESTER
  TRIWULAN
  MID
}

enum NotificationType {
  KEHADIRAN
  REMINDER
  INFO
}

enum NotificationChannel {
  PUSH
  EMAIL
  WA
}

enum Platform {
  ANDROID
  IOS
}

// ===================== USER =====================

model User {
  id           String   @id @default(uuid())
  role         Role
  fullName     String   @map("full_name")
  email        String   @unique
  phone        String?
  passwordHash String   @map("password_hash")
  isActive     Boolean  @default(true) @map("is_active")
  // Null = email belum diverifikasi (akun hasil pendaftaran mandiri).
  emailVerifiedAt DateTime? @map("email_verified_at")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  // Relasi
  homeroomClasses     Class[]              @relation("Homeroom")
  teachingSchedules   Schedule[]           @relation("TeacherSchedule")
  lessonLogs          LessonLog[]          @relation("LessonLogTeacher")
  studentProfile      Student?             @relation("StudentAccount")
  parentLinks         StudentParent[]      @relation("ParentUser")
  recordedAttendances Attendance[]         @relation("RecordedBy")
  createdSessions     AttendanceSession[]  @relation("SessionCreatedBy")
  createdEvents       Event[]              @relation("EventCreatedBy")
  pushTokens          PushToken[]
  notifications       Notification[]
  auditLogs           AuditLog[]
  refreshTokens       RefreshToken[]
  verificationTokens  VerificationToken[]

  @@index([role])
  @@map("users")
}

// Token verifikasi email untuk pendaftaran mandiri (sekali pakai).
model VerificationToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @map("token_hash") // sha256 dari token (bukan token mentah)
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("verification_tokens")
}

// ===================== KELAS =====================

model Class {
  id                String   @id @default(uuid())
  name              String
  grade             Int
  academicYear      String   @map("academic_year")
  homeroomTeacherId String?  @map("homeroom_teacher_id")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  homeroomTeacher    User?               @relation("Homeroom", fields: [homeroomTeacherId], references: [id])
  students           Student[]
  schedules          Schedule[]
  targetedEvents     Event[]             @relation("EventTargetClass")
  attendanceSessions AttendanceSession[]
  lessonLogs         LessonLog[]

  @@index([academicYear])
  @@map("classes")
}

// ===================== MURID =====================

model Student {
  id        String   @id @default(uuid())
  nisn      String   @unique
  nis       String?
  fullName  String   @map("full_name")
  classId   String?  @map("class_id")
  gender    Gender?
  birthDate DateTime? @map("birth_date")
  address   String?
  userId    String?  @unique @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  class       Class?          @relation(fields: [classId], references: [id])
  account     User?           @relation("StudentAccount", fields: [userId], references: [id])
  parents     StudentParent[]
  attendances Attendance[]

  @@index([classId])
  @@map("students")
}

model StudentParent {
  id           String  @id @default(uuid())
  studentId    String  @map("student_id")
  parentUserId String  @map("parent_user_id")
  relation     String?

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  parent  User    @relation("ParentUser", fields: [parentUserId], references: [id], onDelete: Cascade)

  @@unique([studentId, parentUserId])
  @@map("student_parents")
}

// ===================== MAPEL & JADWAL =====================

model Subject {
  id   String @id @default(uuid())
  name String
  code String? @unique

  schedules  Schedule[]
  lessonLogs LessonLog[]

  @@map("subjects")
}

model Schedule {
  id           String    @id @default(uuid())
  subjectId    String    @map("subject_id")
  classId      String    @map("class_id")
  teacherId    String    @map("teacher_id")
  dayOfWeek    DayOfWeek @map("day_of_week")
  startTime    String    @map("start_time") // format "HH:mm"
  endTime      String    @map("end_time")
  academicYear String    @map("academic_year")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  subject  Subject             @relation(fields: [subjectId], references: [id])
  class    Class               @relation(fields: [classId], references: [id])
  teacher  User                @relation("TeacherSchedule", fields: [teacherId], references: [id])
  sessions AttendanceSession[]

  @@index([classId])
  @@index([teacherId])
  @@map("schedules")
}

// ===================== BUKU BATAS PEMBELAJARAN =====================

// Satu baris = satu pertemuan/sesi mengajar (1 jam pelajaran di 1 kelas),
// meniru kolom "Buku Batas Pembelajaran" fisik SMA Kartini Batam.
model LessonLog {
  id              String   @id @default(uuid())
  classId         String   @map("class_id")
  teacherId       String   @map("teacher_id")
  subjectId       String?  @map("subject_id")
  date            DateTime // Hari/Tgl pertemuan
  jamKe           String   @map("jam_ke") // mis. "1-2"
  namaSiswa       String?  @map("nama_siswa") // kolom opsional sesuai buku asli
  pokokBahasan    String   @map("pokok_bahasan")
  metode          String?
  selesai         Boolean  @default(true) // Selesai (true) / Belum (false)
  siswaTidakHadir String?  @map("siswa_tidak_hadir") // prefill dari presensi, bisa diedit
  refleksi        String?
  tindakLanjut    String?  @map("tindak_lanjut")
  academicYear    String   @map("academic_year") // Tahun Pembelajaran (mis. "2025/2026")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  class   Class    @relation(fields: [classId], references: [id])
  teacher User     @relation("LessonLogTeacher", fields: [teacherId], references: [id])
  subject Subject? @relation(fields: [subjectId], references: [id])

  @@index([classId, date])
  @@index([teacherId])
  @@map("lesson_logs")
}

// ===================== KEGIATAN =====================

model Event {
  id            String   @id @default(uuid())
  title         String
  description   String?
  eventDate     DateTime @map("event_date")
  startTime     String   @map("start_time")
  endTime       String   @map("end_time")
  location      String?
  targetClassId String?  @map("target_class_id")
  createdById   String   @map("created_by")
  createdAt     DateTime @default(now()) @map("created_at")

  targetClass Class?              @relation("EventTargetClass", fields: [targetClassId], references: [id])
  createdBy   User                @relation("EventCreatedBy", fields: [createdById], references: [id])
  sessions    AttendanceSession[]

  @@index([eventDate])
  @@map("events")
}

// ===================== PERIODE =====================

model Term {
  id           String   @id @default(uuid())
  academicYear String   @map("academic_year")
  type         TermType
  name         String
  startDate    DateTime @map("start_date")
  endDate      DateTime @map("end_date")

  sessions AttendanceSession[]

  @@index([academicYear, type])
  @@map("terms")
}

// ===================== PRESENSI =====================

model AttendanceSession {
  id          String           @id @default(uuid())
  sourceType  AttendanceSource @map("source_type")
  scheduleId  String?          @map("schedule_id")
  eventId     String?          @map("event_id")
  // Snapshot kelas saat sesi dibuat — agar rekap historis tetap akurat
  // walau murid pindah kelas. Null untuk kegiatan tanpa kelas sasaran.
  classId     String?          @map("class_id")
  sessionDate DateTime         @map("session_date")
  termId      String?          @map("term_id")
  createdById String           @map("created_by")
  createdAt   DateTime         @default(now()) @map("created_at")

  schedule  Schedule?    @relation(fields: [scheduleId], references: [id])
  event     Event?       @relation(fields: [eventId], references: [id])
  class     Class?       @relation(fields: [classId], references: [id])
  term      Term?        @relation(fields: [termId], references: [id])
  createdBy User         @relation("SessionCreatedBy", fields: [createdById], references: [id])
  records   Attendance[]

  @@index([sessionDate])
  @@index([termId])
  @@index([classId])
  @@map("attendance_sessions")
}

// ===================== REFRESH TOKEN (rotasi & revocation) =====================

model RefreshToken {
  id        String    @id @default(uuid()) // dipakai sebagai jti pada JWT refresh
  userId    String    @map("user_id")
  tokenHash String    @map("token_hash") // sha256 dari token (bukan token mentah)
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model Attendance {
  id         String           @id @default(uuid())
  sessionId  String           @map("session_id")
  studentId  String           @map("student_id")
  status     AttendanceStatus
  note       String?
  recordedById String         @map("recorded_by")
  recordedAt DateTime         @default(now()) @map("recorded_at")

  session    AttendanceSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  student    Student           @relation(fields: [studentId], references: [id])
  recordedBy User              @relation("RecordedBy", fields: [recordedById], references: [id])

  @@unique([sessionId, studentId])
  @@index([studentId])
  @@map("attendance")
}

// ===================== NOTIFIKASI =====================

model PushToken {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  token     String
  platform  Platform
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@map("push_tokens")
}

model Notification {
  id      String              @id @default(uuid())
  userId  String              @map("user_id")
  type    NotificationType
  title   String
  body    String
  channel NotificationChannel
  isRead  Boolean             @default(false) @map("is_read")
  sentAt  DateTime            @default(now()) @map("sent_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("notifications")
}

// ===================== AUDIT =====================

model AuditLog {
  id        String   @id @default(uuid())
  actorId   String?  @map("actor_id")
  action    String
  entity    String
  entityId  String?  @map("entity_id")
  changes   Json?
  createdAt DateTime @default(now()) @map("created_at")

  actor User? @relation(fields: [actorId], references: [id])

  @@map("audit_logs")
}

// ===================== PENGATURAN SEKOLAH =====================

// Satu baris (singleton) berisi pengaturan notifikasi & template pesan.
model Setting {
  id                 String   @id @default("singleton")
  channelPush        Boolean  @default(true) @map("channel_push")
  channelEmail       Boolean  @default(true) @map("channel_email")
  channelWa          Boolean  @default(false) @map("channel_wa")
  // Status presensi yang memicu notifikasi ke ortu, mis. ["SAKIT","IZIN","ALPHA"]
  notifyStatuses     String[] @map("notify_statuses")
  attendanceTemplate String   @map("attendance_template")
  reminderTemplate   String   @map("reminder_template")
  reminderHour       Int      @default(17) @map("reminder_hour")
  weeklyRecapEnabled Boolean  @default(false) @map("weekly_recap_enabled")
  updatedAt          DateTime @updatedAt @map("updated_at")

  @@map("settings")
}
